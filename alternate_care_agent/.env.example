# .env.example
#
# Copy this file to .env and fill in real values before running the server.
# Never commit .env to version control — it is listed in .gitignore.
#
# -----------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------

# Google AI Studio API key — required for the Gemini explanation step.
# The routing, provider discovery, and ranking steps do NOT use Gemini and
# do NOT need this key.  Tests mock this call and do not need it either.
# Get a free key (no credit card) at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Base URL of the shared Appointment Agent service (teammate's service).
# Required only for /appointments/availability, /appointments/book, etc.
# The /navigate endpoint works without this.
APPOINTMENT_AGENT_BASE_URL=http://localhost:8001

# -----------------------------------------------------------------------
# Optional — override only if using self-hosted instances
# -----------------------------------------------------------------------

# Overpass API endpoint (OpenStreetMap provider search).
# Default: https://overpass-api.de/api/interpreter
# Override to use a self-hosted Overpass instance under high load.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Default search radius for provider discovery, in kilometres.
# Default: 15.0
# Applied when PatientLocation.radius_km is not explicitly set.
# DEFAULT_SEARCH_RADIUS_KM=15.0

# Nominatim geocoding endpoint (address/ZIP → lat/lon).
# Default: https://nominatim.openstreetmap.org/search
# Override to use a self-hosted Nominatim instance (recommended for >1 req/s).
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# User-Agent header sent with every Nominatim request.
# Nominatim's fair-use policy requires a descriptive application name and
# contact address.  Update this for production deployments.
# Default: AlternateCareNavigationAgent/1.0 (development; contact: dev@example.com)
# NOMINATIM_USER_AGENT=YourAppName/1.0 (contact: your@email.com)
