# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# All endpoints require X-API-Key header. Set a strong random secret here.
API_KEY=your-secret-api-key-here

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/medchat

# ── LLM (Google Gemini) ─────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-1.5-flash

# ── Safety Engine ─────────────────────────────────────────────────────────────
SAFETY_RULES_PATH=app/rules/safety_rules.json
