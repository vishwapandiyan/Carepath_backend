# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# All endpoints require X-API-Key header. Set a strong random secret here.
API_KEY=your-secret-api-key-here

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/medchat

# ── LLM Configuration ────────────────────────────────────────────────────────
# Grok (xAI API)
GROK_API_KEY=xai-your-grok-api-key-here
LLM_PROVIDER=grok
LLM_MODEL=grok-beta

# Google Gemini (Fallback or Alternative)
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-3.6-flash

# ── Safety Engine ─────────────────────────────────────────────────────────────
SAFETY_RULES_PATH=app/rules/safety_rules.json
